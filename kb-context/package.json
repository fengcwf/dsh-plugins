{
  "name": "kb-context",
  "version": "0.3.1",
  "description": "DeepSeek Harness 的 Obsidian vault 上下文插件：触发词/实体命中后把 wiki 片段以 pre-step recall 注入会话，并提供 wiki_search / wiki_read 检索工具（FTS5 + grep 兜底，fail-open）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/tools.js && node --check lib/diagnose.js && node --check lib/settings-routes.js && node --check lib/settings-write.js && node --check lib/client.js && node --test"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "link:/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-llm",
    "@deepseek-ai/dsh-tools": "link:/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-tools"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "kb-context",
    "obsidian",
    "wiki",
    "recall"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fengcwf/dsh-plugins.git",
    "directory": "kb-context"
  }
}
