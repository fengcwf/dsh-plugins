{
  "name": "kb-context",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的 Obsidian vault 上下文插件：触发词/实体命中后把 wiki 片段以 pre-step recall 注入会话，并提供 wiki_search / wiki_read 检索工具（FTS5 + grep 兜底，fail-open）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --test"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "zod": "link:/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/zod"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "kb-context",
    "obsidian",
    "wiki",
    "recall"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fengcwf/dsh-plugins.git",
    "directory": "kb-context"
  }
}
