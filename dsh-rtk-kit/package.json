{
  "name": "dsh-rtk-kit",
  "version": "0.2.0",
  "description": "DeepSeek Harness 的 RTK（Rust Token Killer）集成：bash 命令自动改写走 rtk 压缩输出（resolve 缝、fail-open）+ 会话 awareness 注入 + rtk_doctor 诊断工具",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./rewrite": "./lib/rewrite.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "dsh.plugin.json", "README.zh.md"],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/rewrite.js && node --check lib/awareness.js && node --test"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.1 <0.2.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "link:/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-tools",
    "@deepseek-ai/dsh-llm": "link:/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-llm"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": ["deepseek-harness", "dsh-plugin", "rtk", "token-optimization"],
  "license": "MIT"
}
